{
	"name": "mtg-card-primers",
	"version": "0.14.0",
	"description": "Write study primers for Magic: The Gathering cards and decks. View decklists as text, card stacks or a grid, log sideboard plans and deck changes, and draw combos with each card in its zone. Scryfall data, hover previews and mana symbols.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --test \"tests/**/*.test.ts\"",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"mtg",
		"scryfall"
	],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.5.1",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"author": "Diogo",
	"overrides": {
		"eslint-plugin-n": {
			"minimatch": "^11.0.1"
		},
		"@typescript-eslint/typescript-estree": {
			"minimatch": "^11.0.1"
		}
	}
}
